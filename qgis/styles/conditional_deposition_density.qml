<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis version="3.34" styleCategories="Symbology">
  <pipe><rasterrenderer type="singlebandpseudocolor" band="1" opacity="0.78" classificationMin="0" classificationMax="1">
    <rastershader><colorrampshader colorRampType="INTERPOLATED" classificationMode="1" clip="0">
      <item alpha="0" value="0" label="0" color="#ffffff"/>
      <item alpha="150" value="0.2" label="low" color="#fee8c8"/>
      <item alpha="205" value="0.5" label="medium" color="#fdbb84"/>
      <item alpha="235" value="0.8" label="high" color="#e34a33"/>
      <item alpha="255" value="1" label="highest" color="#7f0000"/>
    </colorrampshader></rastershader>
  </rasterrenderer></pipe>
</qgis>
