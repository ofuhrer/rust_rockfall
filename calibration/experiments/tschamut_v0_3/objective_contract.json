  "model_version": "0.3.0",
  "objective": {
    "description": "Weighted normalized distribution-level mismatch; lower is better.",
    "direction": "lower_is_better",
    "formula_terms": [
      {
        "metric": "runout_distance_error_m",
        "normalization_metric": "observed_mean_runout_m",
        "weight": 0.45
      },
      {
        "metric": "deposition_centroid_error_m",
        "normalization_metric": "observed_mean_runout_m",
        "weight": 0.25
      },
      {
        "metric": "deposition_cloud_mean_nearest_error_m",
        "normalization_metric": "observed_mean_runout_m",
        "weight": 0.2
      },
      {
        "metric": "lateral_spread_error_m",
        "normalization_metric": "observed_mean_runout_m",
        "weight": 0.1
      }
    ],
    "metric_weights": {
      "deposition_centroid_error_m": 0.25,
      "deposition_cloud_mean_nearest_error_m": 0.2,
      "lateral_spread_error_m": 0.1,
      "runout_distance_error_m": 0.45
    },
    "normalization_metric": "observed_mean_runout_m"
  },
  "objective_status": "executable_smoke_ready",
  "parameters": {
    "candidate_count": 144,
    "fixed": {
      "contact_model": "translational_v0",
      "gravity": 9.81,
      "roughness_model": "stochastic_contact_v1"
    },
    "grid": {
